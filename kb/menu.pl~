%================================================================
%REGLAS LOGICAS
%================================================================
%Regla 1 - suma de desayuno comida
suma_parcial_dco(Desayuno, Comida, Subtotal) :-
    desayuno(Desayuno, KcalD),
    comida(Comida, KcalC),
    Subtotal is KcalD + KcalC.
%Regla 2 - suma de las tres comidas
total_de_menu(Desayuno, Comida, Cena, Total) :-
    desayuno(Desayuno, KcalD),
    comida(Comida, KcalCo),
    cena(Cena, KcalC),
    Total is KcalD + KcalCo + KcalC.
%Regla 3 - clasificacion de menu deficit
menu_deficit(D, Co, C) :-
    total__de_menu(D, Co, C, Total),
    Total < 800.
%RRegla 4 - Clasificacion de menu balance
menu_balanceado(D, Co, C) :-
    total_de_menu(D,Co, C, Total),
    Total >= 1300,
    Total =< 1700.
%Rgla 5 - menu excedente
menu_excedente(D, Co, C) :-
    total_de_menu(D, Co, C, Total),
    Total >1700.
%regla 6 - desayuno balnce
desayuno_ligeo(Desayuno) :-
    desayuno(Desayuno, Calorias),
    Calorias =< 600.
%Regla 7- Cena balanceada
cena_liger(Cena) :-
    cena(Cena, Calorias),
    Calorias =< 400.
%Regla 8 - Al menos una debe ser ligera
combinacion_saludable(D, Co, C) :-
    total__de_menu(D, Co, C, _),
    (desayuno_ligero(D); cena_ligera(C)).
%Regla 9 - Validacion de que la comida no sea muy pesada
comida_no_pesad(Comida) :-
    comida(Comida, Calorias),
    Calorias =< 700.
%PREDICADO DE BUSQUEDA
generar_el_menu(MaxCalorias, MinCalorias, D, Co, C, TotalCalorias) :-
    desayuno(D, _),
    comida(Co, _),
    cena(C, _),
    total_de_menu(D, Co, C, TotalCalorias),
    TotalCalorias =< MaxCalorias,
    TotalCalorias >= MinCalorias,
    comida_no_pesad(Co).
